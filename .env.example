# Local development only. Export changed values for the host-run backend as well.
LIVEFLOW_MYSQL_PORT=13306
LIVEFLOW_MYSQL_DATABASE=liveflow
LIVEFLOW_MYSQL_USER=liveflow
LIVEFLOW_MYSQL_PASSWORD=liveflow_dev
LIVEFLOW_MYSQL_ROOT_PASSWORD=liveflow_root_dev
LIVEFLOW_REDIS_PORT=16379
LIVEFLOW_KAFKA_PORT=19092
LIVEFLOW_PORT=18080
# 用 openssl rand -base64 32 生成并在启动后端的终端中导出。
LIVEFLOW_JWT_SIGNING_KEY=
# 仅在 local profile 和回环 HTTP 下可以显式改为 false。
LIVEFLOW_LOCAL_SECURE_COOKIE=true
